{
  "manifest_version": 3,
  "name": "LucClock — Floating Clock & Timers",
  "version": "1.0.0",
  "description": "A calm, minimal 24-hour clock with timer and pomodoro that floats on every tab. Built by Lucas — open to contributions.",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/storage.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
